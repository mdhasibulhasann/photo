const SPREADSHEET_ID = '1aVOUmPxjEOKLR6ziKz0iSFNenTh48OXjZy0ulSgpHUU';
function setup(){const props=PropertiesService.getScriptProperties();if(!props.getProperty('ACCESS_PASSWORD'))props.setProperty('ACCESS_PASSWORD','xoxo');if(!props.getProperty('SESSION_SECRET'))props.setProperty('SESSION_SECRET',Utilities.getUuid()+Utilities.getUuid());}
function output(data){return ContentService.createTextOutput(JSON.stringify(data)).setMimeType(ContentService.MimeType.JSON);}
function sign(value){return Utilities.base64EncodeWebSafe(Utilities.computeHmacSha256Signature(value,PropertiesService.getScriptProperties().getProperty('SESSION_SECRET')));}
function doGet(){return output({ok:true,message:'Application directory service. Use the website to sign in.'});}
function doPost(e){try{const b=JSON.parse(e.postData.contents||'{}'),props=PropertiesService.getScriptProperties();if(!props.getProperty('SESSION_SECRET'))return output({error:'Run setup() once in Apps Script.',status:503});
if(b.action==='login'){const cache=CacheService.getScriptCache(),key='failedLogins';let attempts=Number(cache.get(key)||0);if(attempts>=20)return output({error:'Too many attempts. Try again in 5 minutes.',status:429});if(b.password!==props.getProperty('ACCESS_PASSWORD')){cache.put(key,String(attempts+1),300);return output({error:'Wrong password. Please try again.',status:401});}let expiry=String(Date.now()+8*3600000);return output({ok:true,token:expiry+'.'+sign(expiry)});}
let parts=String(b.token||'').split('.');if(parts.length!==2||Number(parts[0])<=Date.now()||parts[1]!==sign(parts[0]))return output({error:'Please enter the password.',status:401});
if(b.action!=='data')return output({error:'Unknown action.',status:400});
let ss=SpreadsheetApp.openById(SPREADSHEET_ID),sheet=b.gid?ss.getSheets().find(s=>String(s.getSheetId())===String(b.gid)):ss.getSheets()[0];if(!sheet)return output({error:'Sheet tab ID was not found. Leave it blank for the first tab.',status:400});let rows=sheet.getDataRange().getDisplayValues();return output({...extract(rows,b),updatedAt:new Date().toISOString()});
}catch(err){console.error(err);return output({error:'Could not read the Sheet. Check spreadsheet access, tab ID and deployment settings.',status:500});}}
function norm(x){return String(x).toLowerCase().replace(/[^a-z0-9\u0980-\u09ff]/g,'');}
function extract(rows,selection){if(!rows.length)return {items:[],headers:[]};const headers=rows[0];function index(key,aliases){return selection[key]!==undefined&&selection[key]!==''?Number(selection[key]):headers.findIndex(h=>aliases.includes(norm(h)));}let id=index('id',['applicationid','registrationid','uniqueid','applicantid','id']),name=index('name',['name','fullname','applicantname','participantname','studentname','member1name','firstmembername']),extra=index('extra',['additionalfield','additionalfields','additionalinformation','additionalinfo','additional']);if([id,name,extra].some(x=>x<0||x>=headers.length))return {items:[],headers,needsMapping:true};let map=new Map();for(let row of rows.slice(1)){let key=String(row[id]||'').trim();if(!key)continue;let links=(String(row[extra]||'').match(/https?:\/\/drive\.google\.com\/[^\s"<>\\,}\]]+/g)||[]).map(l=>l.replace(/[).;]+$/,''));if(!links.length)continue;if(!map.has(key))map.set(key,{id:key,names:[],links:[]});let item=map.get(key),n=String(row[name]||'').trim();if(n&&!item.names.includes(n))item.names.push(n);links.forEach(l=>{if(!item.links.includes(l))item.links.push(l);});}return {items:Array.from(map.values()),headers};}
